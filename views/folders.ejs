<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title: 'Folders'}) %>
  </head>
  <body>
    <h1>Folders</h1>
    <% if (locals.folders) { %>
    <ul>
      <% folders.forEach(folder => { %>
      <li><a href="./folders/<%= folder.id %>"><%= folder.name %></a></li>
      <% }) %>
    </ul>
    <% } else { %>
    <p>No folders have been created.</p>
    <% } %>
  </body>
</html>
