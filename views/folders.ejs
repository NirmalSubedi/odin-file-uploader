<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title: 'Folders'}) %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <h1>Folders</h1>
    <form action="/folders/insert" method="post">
      <%- include('partials/input', {label:'New folder', name:'name', placeholder:'Name', required: true}) %>
      <button type="submit">Create folder</button>
    </form>
    <% if (locals.folders.length>0) { %>
    <ul>
      <% folders.forEach(folder => { %>
      <li>
        <a
          href="/folders/<%= folder.id %>"
          aria-label="Open <%= folder.name %> folder"
        ><%= folder.name %></a>
        <div>
          <a
            href="/folders/update/<%= folder.id %>"
            id="folder_update_<%=folder.id%>"
            aria-labelledby="folder_update_<%=folder.id%> folder_<%=folder.id%>_label"
          >Update</a> | <a
            href="/folders/delete/<%= folder.id %>"
            id="folder_delete_<%=folder.id%>"
            aria-labelledby="folder_delete_<%=folder.id%> folder_<%=folder.id%>_label"
          >Delete</a>
          <span aria-hidden="true" hidden id="folder_<%=folder.id%>_label"><%= folder.name %> folder</span>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } else { %>
    <p>No folders have been created.</p>
    <% } %>
  </body>
</html>
