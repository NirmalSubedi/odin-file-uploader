<%- include('partials/errors_hook') %>
<% if(locals.session?.auth_fail_info) {%>
  <% const {path, msg} = session.auth_fail_info; %>
  <%- include('partials/errors_hook', {errors: { mapped: () => ({[path]:msg}), array: ()=> [{path,msg}] }}) %>
<% } %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title') %>
  </head>
  <body>
    <%- include('partials/nav') %>
    <h1>Sign in</h1>
    <%- include('partials/errors') %>
    <p>All fields with (*) are required.</p>
    <form action="/signin" method="post">
      <%- include('partials/input', {label:'Email', name: 'email', type:'email', autofocus: !page.has_error, required: true}) %>
      <%- include('partials/input', {label:'Password', name: 'password', type:'password', required: true}) %>
      <button type="submit">Sign in</button>
    </form>
  </body>
</html>
