<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title:`Folder: ${folder.name}`}) %>
  </head>
  <body>
    <h1><%= folder.name %></h1>
    <%- include('partials/errors') %>
    <form action="./folders/insert" method="post">
      <%- include('partials/input', {label:'New folder', name:'folder_name', placeholder:'Name' required: true}) %>
      <button type="submit">Create folder</button>
    </form>
    <% if (local.files) { %>
    <ul>
      <% files.forEach(file => { %>
      <li><%= file.name %></li>
      <% }) %>
    </ul>
    <% } else { %>
    <p>No files have been uploaded.</p>
    <% } %>
  </body>
</html>
