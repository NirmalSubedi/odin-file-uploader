<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/title', {title:`Folder: ${folder.name}`}) %>
  </head>
  <body>
    <h1><%= folder.name %></h1>
    <% if (folder.files.length>0) { %>
    <ul>
      <% folder.files.forEach(file => { %>
      <li><%= file.name %></li>
      <% }) %>
    </ul>
    <% } else { %>
    <p>No files have been uploaded.</p>
    <% } %>
  </body>
</html>
