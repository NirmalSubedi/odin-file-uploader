generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user_sessions {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model users {
  email    String    @id
  password String
  folders  folders[]
}

model folders {
  id         Int     @id @default(autoincrement())
  name       String
  files      files[]
  user       users   @relation(fields: [user_email], references: [email])
  user_email String
}

model files {
  id          Int     @id @default(autoincrement())
  name        String
  size        Int // Unit: bytes
  upload_time Float // Unit: ms
  folder      folders @relation(fields: [folder_id], references: [id])
  folder_id   Int
}
