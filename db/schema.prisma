generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  email    String    @id
  password String
  folders  folders[]
}

model user_sessions {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model folders {
  user       users  @relation(fields: [user_email], references: [email])
  user_email String
  name       String
}
